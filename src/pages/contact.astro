---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Contact Us"
	description="Get in touch with Waliya to discuss your next project."
>
	<section class="mx-auto max-w-7xl px-6 py-20 md:py-28">
		<div class="max-w-3xl">
			<a
				id="dynamic-back-link"
				href="/"
				class="mb-8 hidden items-center gap-2 text-sm font-medium text-gray-500 transition-colors hover:text-[#3A6931] dark:text-gray-400 dark:hover:text-green-500"
			>
				&larr; Back to Home
			</a>
			<p class="text-sm font-semibold uppercase tracking-[0.16em] text-primary-green dark:text-dark-green">
				Contact
			</p>
			<h1 id="contact-heading" class="mt-4 text-4xl font-semibold tracking-tight text-primary-dark dark:text-dark-text md:text-5xl">
				Let’s start a conversation.
			</h1>
			<p class="mt-5 text-lg leading-8 text-text">
				Tell us a little about what you need. We’ll help you identify a practical next step.
			</p>
		</div>

		<div class="mt-12 grid gap-12 lg:grid-cols-[minmax(0,1.2fr)_minmax(18rem,0.8fr)] lg:gap-20">
			<div class="space-y-4">
				<form
					id="contact-form"
					action="https://api.web3forms.com/submit"
					method="POST"
					data-astro-reload
					class="space-y-6"
				>
					<!-- Replace YOUR_ACCESS_KEY_HERE with your actual key -->
					<input type="hidden" name="access_key" value="9919704a-968d-4211-8e27-48b0a6484b58" />
					<div>
						<label for="name" class="mb-2 block text-sm font-semibold text-primary-dark dark:text-dark-text">
							Name
						</label>
						<input
							id="name"
							name="name"
							type="text"
							autocomplete="name"
							required
							class="w-full border border-primary-green bg-white px-4 py-3 text-text outline-none transition focus:border-primary-dark dark:border-dark-green dark:bg-dark-surface dark:focus:border-dark-text"
						/>
					</div>
					<div>
						<label for="business-name" class="mb-2 block text-sm font-semibold text-primary-dark dark:text-dark-text">
							Business Name
						</label>
						<input
							id="business-name"
							name="business_name"
							type="text"
							autocomplete="organization"
							class="w-full border border-primary-green bg-white px-4 py-3 text-text outline-none transition focus:border-primary-dark dark:border-dark-green dark:bg-dark-surface dark:focus:border-dark-text"
						/>
					</div>
					<div>
						<label for="country" class="mb-2 block text-sm font-semibold text-primary-dark dark:text-dark-text">
							Country
						</label>
						<input
							id="country"
							name="country"
							type="text"
							autocomplete="country-name"
							required
							class="w-full border border-primary-green bg-white px-4 py-3 text-text outline-none transition focus:border-primary-dark dark:border-dark-green dark:bg-dark-surface dark:focus:border-dark-text"
						/>
					</div>
					<div>
						<label for="time-zone" class="mb-2 block text-sm font-semibold text-primary-dark dark:text-dark-text">
							Time Zone <span class="font-normal text-gray-500 dark:text-gray-400">(optional)</span>
						</label>
						<input
							id="time-zone"
							name="time_zone"
							type="text"
							autocomplete="off"
							class="w-full border border-primary-green bg-white px-4 py-3 text-text outline-none transition focus:border-primary-dark dark:border-dark-green dark:bg-dark-surface dark:focus:border-dark-text"
						/>
					</div>
					<div>
						<label for="email" class="mb-2 block text-sm font-semibold text-primary-dark dark:text-dark-text">
							Email
						</label>
						<input
							id="email"
							name="email"
							type="email"
							autocomplete="email"
							required
							class="w-full border border-primary-green bg-white px-4 py-3 text-text outline-none transition focus:border-primary-dark dark:border-dark-green dark:bg-dark-surface dark:focus:border-dark-text"
						/>
					</div>
					<div>
						<label for="message" class="mb-2 block text-sm font-semibold text-primary-dark dark:text-dark-text">
							Message
						</label>
						<textarea
							id="message"
							name="message"
							rows="6"
							required
							class="w-full resize-y border border-primary-green bg-white px-4 py-3 text-text outline-none transition focus:border-primary-dark dark:border-dark-green dark:bg-dark-surface dark:focus:border-dark-text"
						></textarea>
					</div>
					<button
						type="submit"
						class="inline-flex items-center justify-center bg-primary-green px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-primary-dark"
					>
						Send Message
					</button>
				</form>
				<p
					id="contact-success"
					class="hidden text-sm font-medium text-primary-dark dark:text-dark-text"
					role="status"
					aria-live="polite"
				>
					Thank you! Your message has been sent.
				</p>
				<p id="contact-error" class="hidden text-sm font-medium text-[#8C3721] dark:text-[#FCA5A5]" role="alert">
					We couldn’t send your message. Please try again.
				</p>
			</div>

			<aside class="h-fit border border-border bg-surface p-8 md:p-10">
				<h2 class="text-xl font-semibold text-primary-dark dark:text-dark-text">Contact details</h2>
				<p class="mt-3 leading-7 text-text">
					Prefer a direct conversation? We&apos;re ready to discuss your goals and how we can help you
					achieve them. Reach out to us directly, and we&apos;ll get back to you within one business
					day.
				</p>
				<dl class="mt-7 divide-y divide-border dark:divide-dark-border">
					<div class="pb-5">
						<dt class="flex items-center gap-2 text-sm font-semibold text-primary-dark dark:text-dark-text">
							<svg
								class="size-4 text-primary-green dark:text-dark-green"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<rect x="3" y="5" width="18" height="14" rx="1.5"></rect>
								<path d="m4 7 8 6 8-6"></path>
							</svg>
							Email
						</dt>
						<dd class="mt-1 pl-6">
							<a
								href="mailto:waliya.info@gmail.com"
								class="text-text transition-colors hover:text-primary-green hover:underline dark:hover:text-dark-green"
							>
								waliya.info@gmail.com
							</a>
						</dd>
					</div>
					<div class="py-5">
						<dt class="flex items-center gap-2 text-sm font-semibold text-primary-dark dark:text-dark-text">
							<svg
								class="size-4 text-primary-green dark:text-dark-green"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="M7 3.5h3l1.5 4-2 1.5a15 15 0 0 0 5.5 5.5l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 5 6.2 2 2 0 0 1 7 3.5Z"></path>
							</svg>
							Phone
						</dt>
						<dd class="mt-1 pl-6">
							<a
								href="tel:+917032288966"
								class="text-text transition-colors hover:text-primary-green hover:underline dark:hover:text-dark-green"
							>
								+91 703 22 88 966
							</a>
						</dd>
					</div>
					<div class="pt-5">
						<dt class="flex items-center gap-2 text-sm font-semibold text-primary-dark dark:text-dark-text">
							<svg
								class="size-4 text-primary-green dark:text-dark-green"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path>
								<circle cx="12" cy="10" r="2.5"></circle>
							</svg>
							Location
						</dt>
						<dd class="mt-1 pl-6 text-text">Hyderabad, India</dd>
					</div>
				</dl>
				<p class="mt-6 border-t border-border pt-5 text-sm leading-6 text-text dark:border-dark-border">
					For international clients: We offer a 4-hour daily overlap with US EST and full overlap
					with UK GMT. We can invoice in USD, EUR, or GBP.
				</p>
			</aside>
		</div>
	</section>
</BaseLayout>

<script>
	const initializePackageSelection = () => {
		const plan = new URLSearchParams(window.location.search).get("plan");
		if (!plan) return;

		const heading = document.getElementById("contact-heading");
		if (heading) heading.textContent = `Let’s discuss your ${plan} Package`;

		const message = document.getElementById("message");
		if (!(message instanceof HTMLTextAreaElement) || message.value.trim()) return;

		message.value = `Hi Waliya team,

I am interested in the ${plan} Website Package. Here are a few details about my project:

- Business Name:${" "}
- Country:${" "}
- Main Goal for the website:${" "}
- Do you have existing content/branding?${" "}

Please let me know the next steps to get started.`;
	};

	document.addEventListener("astro:page-load", initializePackageSelection);
	initializePackageSelection();

	const initializeVisitorLocation = async () => {
		const countryField = document.getElementById("country");
		const timeZoneField = document.getElementById("time-zone");

		if (timeZoneField instanceof HTMLInputElement && !timeZoneField.value.trim()) {
			try {
				const detectedTimeZone = Intl.DateTimeFormat().resolvedOptions().timeZone;
				const timeZone = detectedTimeZone === "Asia/Calcutta" ? "Asia/Kolkata" : detectedTimeZone;
				const offsetMinutes = -new Date().getTimezoneOffset();
				const offsetSign = offsetMinutes >= 0 ? "+" : "-";
				const absoluteOffset = Math.abs(offsetMinutes);
				const offsetHours = Math.floor(absoluteOffset / 60);
				const offsetRemainder = String(absoluteOffset % 60).padStart(2, "0");

				timeZoneField.value = `${timeZone} (GMT${offsetSign}${offsetHours}:${offsetRemainder})`;
			} catch (error) {
				console.error("Unable to detect the browser time zone.", error);
			}
		}

		if (!(countryField instanceof HTMLInputElement) || countryField.value.trim()) return;

		try {
			const response = await fetch("https://www.cloudflare.com/cdn-cgi/trace");
			if (!response.ok) throw new Error(`Country lookup failed with status ${response.status}.`);

			const trace = await response.text();
			const location = trace.split(/\r?\n/).find((line) => line.startsWith("loc="));
			const countryCode = location?.slice("loc=".length).trim();
			if (countryCode && !countryField.value.trim()) {
				const regionNames = new Intl.DisplayNames(["en"], { type: "region" });
				countryField.value = regionNames.of(countryCode) || countryCode;
			}
		} catch (error) {
			console.error("Unable to detect the visitor's country.", error);
		}
	};

	document.addEventListener("astro:page-load", initializeVisitorLocation);
</script>

<script>
	const initializeBackLink = () => {
		const backLink = document.getElementById("dynamic-back-link");
		if (!backLink) return;
		if (backLink.dataset.initialized === "true") return;
		backLink.dataset.initialized = "true";

		const isNavLink = new URLSearchParams(window.location.search).get("ref") === "nav";
		let contactOriginPath: string | null = null;
		try {
			contactOriginPath = sessionStorage.getItem("contactOriginPath");
			sessionStorage.removeItem("contactOriginPath");
		} catch (error) {
			console.error("Unable to read contact navigation history.", error);
		}

		if (isNavLink) {
			backLink.classList.add("hidden");
			return;
		}

		const referrer = document.referrer;
		console.log("Referrer is:", referrer);
		const originPath =
			contactOriginPath || (referrer ? new URL(referrer).pathname : "");
		if (!originPath || originPath === "/contact") {
			backLink.classList.add("hidden");
			return;
		}

		backLink.classList.remove("hidden");
		backLink.classList.add("inline-flex");

		if (originPath === "/services") {
			backLink.innerHTML = "&larr; Back to Services";
			backLink.href = "/services";
		} else if (originPath === "/client-stories") {
			backLink.innerHTML = "&larr; Back to Client Stories";
			backLink.href = "/client-stories";
		} else if (originPath === "/about") {
			backLink.innerHTML = "&larr; Back to About";
			backLink.href = "/about";
		} else {
			backLink.innerHTML = "&larr; Back to Home";
			backLink.href = "/";
		}
	};

	if (document.documentElement.dataset.contactBackLinkHandlerBound !== "true") {
		document.documentElement.dataset.contactBackLinkHandlerBound = "true";
		document.addEventListener("DOMContentLoaded", initializeBackLink);
		document.addEventListener("astro:page-load", initializeBackLink);
	}
	initializeBackLink();
</script>

<script is:inline>
	(() => {
		const form = document.querySelector("#contact-form");
		const successMessage = document.querySelector("#contact-success");
		const errorMessage = document.querySelector("#contact-error");

		if (!(form instanceof HTMLFormElement) || !successMessage || !errorMessage) return;

		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			successMessage.classList.add("hidden");
			errorMessage.classList.add("hidden");

			if (!form.reportValidity()) return;

			const submitButton = form.querySelector('button[type="submit"]');
			if (!(submitButton instanceof HTMLButtonElement)) return;

			const originalLabel = submitButton.textContent;
			submitButton.disabled = true;
			submitButton.textContent = "Sending...";

			try {
				const response = await fetch(form.action, {
					method: "POST",
					headers: {
						"Content-Type": "application/json",
						Accept: "application/json",
					},
					body: JSON.stringify(Object.fromEntries(new FormData(form))),
				});
				const result = await response.json();

				if (!response.ok || result.success !== true) {
					throw new Error("Web3Forms submission failed.");
				}

				form.hidden = true;
				successMessage.classList.remove("hidden");
			} catch {
				errorMessage.classList.remove("hidden");
				submitButton.disabled = false;
				submitButton.textContent = originalLabel;
			}
		});
	})();
</script>
