---
import BaseLayoutRTL from "../../layouts/BaseLayoutRTL.astro";
import { getNames } from "country-list";

const countries = getNames();
---

<BaseLayoutRTL
	title="اتصل بنا"
	description="تواصل مع واليا لمناقشة مشروعك والخطوة العملية التالية."
>
	<section class="mx-auto max-w-7xl px-6 py-20 md:py-28">
		<div class="max-w-3xl">
			<p class="text-sm font-semibold tracking-[0.16em] text-primary-green dark:text-dark-green">
				واليا
			</p>
			<h1 class="mt-4 text-4xl font-semibold leading-relaxed tracking-tight text-primary-dark dark:text-dark-text md:text-5xl">
				اتصل بنا
			</h1>
			<p class="mt-5 text-lg leading-8 text-text">
				أخبرنا قليلاً عمّا تحتاج إليه، وسنساعدك في تحديد الخطوة العملية التالية.
			</p>
		</div>

		<div class="mt-12 grid gap-12 lg:grid-cols-[minmax(0,1.2fr)_minmax(18rem,0.8fr)] lg:gap-20">
			<form
				id="contact-form"
				action="https://api.web3forms.com/submit"
				method="POST"
				data-astro-reload
				class="space-y-6"
			>
				<input type="hidden" name="access_key" value="9919704a-968d-4211-8e27-48b0a6484b58" />
				<div>
					<label for="name" class="mb-2 block text-sm font-semibold text-primary-dark dark:text-dark-text">
						الاسم
					</label>
					<input
						id="name"
						name="name"
						type="text"
						autocomplete="name"
						required
						class="w-full border border-primary-green bg-white px-4 py-3 text-text outline-none transition focus:border-primary-dark dark:border-dark-green dark:bg-dark-surface dark:focus:border-dark-text"
					/>
				</div>
				<div>
					<label for="business-name" class="mb-2 block text-sm font-semibold text-primary-dark dark:text-dark-text">
						اسم الشركة
					</label>
					<input
						id="business-name"
						name="business_name"
						type="text"
						autocomplete="organization"
						class="w-full border border-primary-green bg-white px-4 py-3 text-text outline-none transition focus:border-primary-dark dark:border-dark-green dark:bg-dark-surface dark:focus:border-dark-text"
					/>
				</div>
				<div>
					<label for="country" class="mb-2 block text-sm font-semibold text-primary-dark dark:text-dark-text">
						الدولة
					</label>
					<input
						id="country"
						name="country"
						type="text"
						list="country-list"
						autocomplete="country-name"
						required
						class="w-full border border-primary-green bg-white px-4 py-3 text-text outline-none transition focus:border-primary-dark dark:border-dark-green dark:bg-dark-surface dark:focus:border-dark-text"
					/>
					<datalist id="country-list">
						{countries.map((country) => <option value={country}></option>)}
					</datalist>
				</div>
				<div>
					<label for="time-zone" class="mb-2 block text-sm font-semibold text-primary-dark dark:text-dark-text">
						المنطقة الزمنية <span class="font-normal text-gray-500 dark:text-gray-400">(اختياري)</span>
					</label>
					<input
						id="time-zone"
						name="time_zone"
						type="text"
						autocomplete="off"
						class="w-full border border-primary-green bg-white px-4 py-3 text-text outline-none transition focus:border-primary-dark dark:border-dark-green dark:bg-dark-surface dark:focus:border-dark-text"
					/>
				</div>
				<div>
					<label for="email" class="mb-2 block text-sm font-semibold text-primary-dark dark:text-dark-text">
						البريد الإلكتروني
					</label>
					<input
						id="email"
						name="email"
						type="email"
						autocomplete="email"
						required
						class="w-full border border-primary-green bg-white px-4 py-3 text-text outline-none transition focus:border-primary-dark dark:border-dark-green dark:bg-dark-surface dark:focus:border-dark-text"
					/>
				</div>
				<div>
					<label for="message" class="mb-2 block text-sm font-semibold text-primary-dark dark:text-dark-text">
						الرسالة
					</label>
					<textarea
						id="message"
						name="message"
						rows="6"
						required
						class="w-full resize-y border border-primary-green bg-white px-4 py-3 text-text outline-none transition focus:border-primary-dark dark:border-dark-green dark:bg-dark-surface dark:focus:border-dark-text"
					></textarea>
				</div>
				<button
					type="submit"
					class="inline-flex items-center justify-center bg-primary-green px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-primary-dark"
				>
					إرسال الرسالة
				</button>
			</form>

			<aside class="h-fit border border-border bg-surface p-8 md:p-10">
				<h2 class="text-xl font-semibold text-primary-dark dark:text-dark-text">بيانات التواصل</h2>
				<p class="mt-3 leading-7 text-text">
					هل تفضل التواصل مباشرة؟ يسعدنا مناقشة أهدافك وكيف يمكننا مساعدتك على تحقيقها.
				</p>
				<dl class="mt-7 divide-y divide-border dark:divide-dark-border">
					<div class="py-5 first:pt-0">
						<dt class="text-sm font-semibold text-primary-dark dark:text-dark-text">البريد الإلكتروني</dt>
						<dd class="mt-1">
							<a href="mailto:waliya.info@gmail.com" class="text-text transition-colors hover:text-primary-green hover:underline dark:hover:text-dark-green">
								waliya.info@gmail.com
							</a>
						</dd>
					</div>
					<div class="pt-5">
						<dt class="text-sm font-semibold text-primary-dark dark:text-dark-text">الهاتف</dt>
						<dd class="mt-1">
							<a href="tel:+917032288966" class="text-text transition-colors hover:text-primary-green hover:underline dark:hover:text-dark-green">
								+91 703 22 88 966
							</a>
						</dd>
					</div>
				</dl>
			</aside>
		</div>
	</section>
</BaseLayoutRTL>

<script>
	const initializeVisitorLocation = async () => {
		const countryField = document.getElementById("country");
		const timeZoneField = document.getElementById("time-zone");

		if (timeZoneField instanceof HTMLInputElement && !timeZoneField.value.trim()) {
			try {
				const detectedTimeZone = Intl.DateTimeFormat().resolvedOptions().timeZone;
				const timeZone = detectedTimeZone === "Asia/Calcutta" ? "Asia/Kolkata" : detectedTimeZone;
				const offsetMinutes = -new Date().getTimezoneOffset();
				const offsetSign = offsetMinutes >= 0 ? "+" : "-";
				const absoluteOffset = Math.abs(offsetMinutes);
				const offsetHours = Math.floor(absoluteOffset / 60);
				const offsetRemainder = String(absoluteOffset % 60).padStart(2, "0");

				timeZoneField.value = `${timeZone} (GMT${offsetSign}${offsetHours}:${offsetRemainder})`;
			} catch (error) {
				console.error("Unable to detect the browser time zone.", error);
			}
		}

		if (!(countryField instanceof HTMLInputElement) || countryField.value.trim()) return;

		try {
			const response = await fetch("https://www.cloudflare.com/cdn-cgi/trace");
			if (!response.ok) throw new Error(`Country lookup failed with status ${response.status}.`);

			const trace = await response.text();
			const location = trace.split(/\r?\n/).find((line) => line.startsWith("loc="));
			const countryCode = location?.slice("loc=".length).trim();
			if (countryCode && !countryField.value.trim()) {
				const regionNames = new Intl.DisplayNames(["en"], { type: "region" });
				countryField.value = regionNames.of(countryCode) || countryCode;
			}
		} catch (error) {
			console.error("Unable to detect the visitor's country.", error);
		}
	};

	document.addEventListener("astro:page-load", initializeVisitorLocation);
	initializeVisitorLocation();
</script>
