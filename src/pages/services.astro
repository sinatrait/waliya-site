---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import PricingModal from "../components/PricingModal.astro";

const services = [
	{
		title: "Website Design & Development",
		icon: "website",
		description:
			"Custom-built, responsive websites that act as the digital storefront for your business. We focus on speed, SEO, and user experience.",
		bullets: [
			"Custom UI/UX Design",
			"Mobile-Responsive Layouts",
			"SEO-Optimized Code",
			"Online Store & Inquiry Form Integration",
		],
	},
	{
		title: "UI/UX Design",
		icon: "uiux",
		description:
			"We shape clear, accessible digital experiences around the needs of your customers and the goals of your business, from early research through polished interface design.",
		bullets: [
			"User and audience research",
			"Information architecture and user flows",
			"Wireframes and interactive prototypes",
			"Responsive interface design",
		],
	},
	{
		title: "Graphic Design & Branding",
		icon: "branding",
		description:
			"From logo creation to complete visual identities, we ensure your brand looks professional everywhere.",
		bullets: [
			"Logo Design",
			"Brand Guidelines",
			"Marketing Collateral",
			"Social Media Assets",
		],
	},
	{
		title: "Digital Marketing",
		icon: "marketing",
		description:
			"Data-driven marketing strategies to increase your visibility and drive qualified traffic to your website.",
		bullets: [
			"Search Engine Optimization",
			"Social Media Strategy",
			"Email Campaigns",
			"Analytics & Reporting",
		],
	},
	{
		title: "Website Maintenance",
		icon: "maintenance",
		description:
			"We keep your digital presence secure and up-to-date so you can focus on running your business.",
		bullets: [
			"Security & Plugin Updates",
			"Bug Fixes",
			"Performance Checks",
			"Content Updates",
		],
	},
	{
		title: "Packaging Design",
		icon: "packaging",
		description:
			"Packaging that protects your product, communicates your brand clearly, and creates a considered experience from shelf to delivery.",
		bullets: [
			"Product packaging concepts",
			"Label and information layout",
			"Print-ready artwork and specifications",
			"Packaging aligned with brand guidelines",
		],
	},
	{
		title: "Digital Experiences",
		icon: "experience",
		description:
			"Engaging digital touchpoints that bring your brand, content, and services together across devices and platforms.",
		bullets: [
			"Interactive campaign and landing pages",
			"Digital product and service experiences",
			"Cross-device experience design",
			"Content and interaction planning",
		],
	},
	{
		title: "Publications",
		icon: "publication",
		description:
			"Thoughtfully designed print and digital publications that make complex information engaging, clear, and easy to navigate.",
		bullets: [
			"Reports, brochures, and company profiles",
			"Editorial layout and typography",
			"Digital and print-ready formats",
			"Publication design aligned with your brand",
		],
	},
];
---

<BaseLayout
	title="Our Services"
	description="Explore Waliya's website, UI/UX, branding, marketing, packaging, digital experience, and publication services."
>
	<section class="mx-auto max-w-7xl px-6 py-20 md:py-28">
		<div class="max-w-3xl">
			<p class="text-sm font-semibold uppercase tracking-[0.16em] text-primary-green dark:text-dark-green">
				How we can help
			</p>
			<h1 class="mt-4 text-4xl font-semibold tracking-tight text-primary-dark dark:text-dark-text md:text-5xl">
				Our Digital Solutions
			</h1>
			<p class="mt-5 text-lg leading-8 text-text">
				From establishing your digital presence to keeping it current and reaching your audience,
				our services help your business make steady progress online.
			</p>
		</div>

		<div class="mx-auto mt-14 grid max-w-6xl gap-5 md:grid-cols-2">
			{
				services.map((service) => (
					<ServiceCard
						{...service}
						viewPricing={service.title === "Website Design & Development"}
					/>
				))
			}
		</div>
	</section>
	<PricingModal />
</BaseLayout>
