---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceCard from "../components/ServiceCard.astro";

const services = [
	{
		title: "Website Design & Development",
		icon: "website",
		description:
			"Custom-built, responsive websites that act as the digital storefront for your business. We focus on speed, SEO, and user experience.",
		bullets: [
			"Custom UI/UX Design",
			"Mobile-Responsive Layouts",
			"SEO-Optimized Code",
			"Online Store & Inquiry Form Integration",
		],
	},
	{
		title: "Website Maintenance",
		icon: "maintenance",
		description:
			"We keep your digital presence secure and up-to-date so you can focus on running your business.",
		bullets: ["Security & Plugin Updates", "Bug Fixes", "Performance Checks", "Content Updates"],
	},
	{
		title: "Graphic Design & Branding",
		icon: "branding",
		description:
			"From logo creation to complete visual identities, we ensure your brand looks professional everywhere.",
		bullets: ["Logo Design", "Brand Guidelines", "Marketing Collateral", "Social Media Assets"],
	},
	{
		title: "Digital Marketing",
		icon: "marketing",
		description:
			"Data-driven marketing strategies to increase your visibility and drive qualified traffic to your website.",
		bullets: [
			"Search Engine Optimization",
			"Social Media Strategy",
			"Email Campaigns",
			"Analytics & Reporting",
		],
	},
];
---

<BaseLayout
	title="Our Services"
	description="Explore our web design, maintenance, branding, and digital marketing services."
>
	<section class="mx-auto max-w-7xl px-6 py-20 md:py-28">
		<div class="max-w-3xl">
			<p class="text-sm font-semibold uppercase tracking-[0.16em] text-primary-green dark:text-dark-green">
				How we can help
			</p>
			<h1 class="mt-4 text-4xl font-semibold tracking-tight text-primary-dark dark:text-dark-text md:text-5xl">
				Our Digital Solutions
			</h1>
			<p class="mt-5 text-lg leading-8 text-text">
				From establishing your digital presence to keeping it current and reaching your audience,
				our services help your business make steady progress online.
			</p>
		</div>

		<div class="mx-auto mt-14 grid max-w-5xl gap-5 md:grid-cols-2">
			{services.map((service) => <ServiceCard {...service} />)}
		</div>
	</section>
</BaseLayout>
