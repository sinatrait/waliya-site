---
interface Props {
	title: string;
	description: string;
	bullets?: string[];
	showBullets?: boolean;
	icon:
		| "website"
		| "maintenance"
		| "branding"
		| "marketing"
		| "uiux"
		| "packaging"
		| "experience"
		| "publication";
	layout?: "wide" | "standard";
	variant?: "featured" | "surface" | "standard";
}

const {
	title,
	description,
	bullets = [],
	showBullets = true,
	icon,
	layout = "standard",
	variant = "standard",
} = Astro.props;

const cardStyles = {
	featured: {
		card: "border-[#2A4D24] bg-[#2A4D24]",
		icon: "text-white/80",
		title: "text-white",
		description: "text-white/80",
		bullets: "text-white",
	},
	surface: {
		card: "border-border bg-[#F7F6F2] dark:bg-dark-surface",
		icon: "text-primary-green dark:text-dark-green",
		title: "text-primary-dark dark:text-dark-text",
		description: "text-text",
		bullets: "text-text dark:text-dark-text",
	},
	standard: {
		card: "border-border bg-white dark:bg-dark-surface",
		icon: "text-primary-green dark:text-dark-green",
		title: "text-primary-dark dark:text-dark-text",
		description: "text-text",
		bullets: "text-text dark:text-dark-text",
	},
};

const styles = cardStyles[variant];
---

<article
	class:list={[
		"rounded-sm border p-8 transition-all duration-300 ease-out hover:scale-[1.02] hover:border-primary-green hover:shadow-lg md:p-10",
		layout === "wide" && "md:col-span-2",
		styles.card,
	]}
>
	<svg
		class:list={["mb-6 size-8 shrink-0", styles.icon]}
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="1.5"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		{icon === "website" && (
			<>
				<rect x="3.5" y="4.5" width="17" height="15" rx="1.5"></rect>
				<path d="M3.5 8.5h17M7 6.5h.01M10 6.5h.01M10 12l-2 2 2 2M14 16l2-2-2-2M13 11.5l-2 5"></path>
			</>
		)}
		{icon === "maintenance" && (
			<>
				<path d="M14.5 6.2a5 5 0 0 0-6.7 6.7l-4.1 4.2a1.8 1.8 0 0 0 2.5 2.5l4.2-4.1a5 5 0 0 0 6.7-6.7l-3 3-2.6-.7-.7-2.6 3.7-2.3Z"></path>
				<path d="m15.5 15.5 4.2 4.2"></path>
			</>
		)}
		{icon === "branding" && (
			<>
				<path d="m4 16.8-.8 4 4-.8L19 8.2a2.8 2.8 0 0 0-4-4L4 16.8Z"></path>
				<path d="m13.5 5.7 4.8 4.8M4 16.8l4 4"></path>
			</>
		)}
		{icon === "marketing" && (
			<>
				<path d="M4 19.5h16M6.5 16v-4M11 16V8M15.5 16v-6M5 8.5l5-3 4 2 5-3"></path>
				<path d="M15.5 4.5H19v3.5"></path>
			</>
		)}
		{icon === "uiux" && (
			<>
				<rect x="3.5" y="4.5" width="17" height="15" rx="1.5"></rect>
				<path d="M8 9h8M8 12h5M8 15h3"></path>
				<circle cx="17" cy="15" r="2"></circle>
			</>
		)}
		{icon === "packaging" && (
			<>
				<path d="m4 8 8-4 8 4v9l-8 4-8-4V8Z"></path>
				<path d="m4 8 8 4 8-4M12 12v9M8 6l8 4"></path>
			</>
		)}
		{icon === "experience" && (
			<>
				<rect x="3.5" y="4.5" width="17" height="15" rx="1.5"></rect>
				<path d="M8 19.5v-3h8v3M8 8h8M8 11h5"></path>
			</>
		)}
		{icon === "publication" && (
			<>
				<path d="M4.5 5.5h10a3 3 0 0 1 3 3v10h-10a3 3 0 0 0-3 3v-16Z"></path>
				<path d="M17.5 18.5h2v-13h-5M8 9h6M8 12h6"></path>
			</>
		)}
	</svg>
	<h3 class:list={["font-semibold tracking-tight", layout === "wide" && variant === "featured" ? "text-3xl md:text-4xl" : "text-xl", styles.title]}>{title}</h3>
	<p class:list={["mt-3 leading-7", layout === "standard" ? "text-sm" : "text-base", styles.description]}>{description}</p>
	{showBullets && bullets.length > 0 && (
		<ul class:list={["mt-4 list-disc space-y-1 pl-5 text-sm opacity-80", styles.bullets]}>
			{bullets.map((bullet) => <li>{bullet}</li>)}
		</ul>
	)}
</article>
