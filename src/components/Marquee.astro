---
const message =
	"WEBSITE DESIGN & DEVELOPMENT • BRANDING • DIGITAL MARKETING • WEBSITE MAINTENANCE• ";
---

<section class="overflow-hidden bg-[#3A6931] py-5 text-white" aria-label="Our services">
	<div class="marquee-track flex w-max" aria-hidden="true">
		<div class="marquee-group flex shrink-0 items-center">
			<span class="whitespace-nowrap px-4 text-2xl font-bold tracking-widest">{message}</span>
		</div>
		<div class="marquee-group flex shrink-0 items-center">
			<span class="whitespace-nowrap px-4 text-2xl font-bold tracking-widest">{message}</span>
		</div>
	</div>
</section>

<style>
	.marquee-track {
		animation: marquee-scroll 32s linear infinite;
	}

	@keyframes marquee-scroll {
		from {
			transform: translateX(0);
		}

		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.marquee-track {
			animation: none;
		}
	}
</style>
