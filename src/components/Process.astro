---
const steps = [
	{
		number: "01",
		title: "Discover",
		description:
			"We dive deep into your business model, target audience, and goals to establish a solid strategic foundation.",
		icon: "discover",
	},
	{
		number: "02",
		title: "Design",
		description:
			"Our team crafts intuitive, visually striking interfaces that align perfectly with your brand identity.",
		icon: "design",
	},
	{
		number: "03",
		title: "Develop",
		description:
			"We bring designs to life with clean, efficient code, ensuring fast performance and flawless mobile responsiveness.",
		icon: "develop",
	},
	{
		number: "04",
		title: "Deliver",
		description:
			"We launch your project, conduct rigorous testing, and provide ongoing support to ensure continued success.",
		icon: "deliver",
	},
];
---

<section class="process-section bg-surface py-20 md:py-24">
	<div class="mx-auto max-w-7xl px-6">
		<div class="max-w-2xl">
			<p class="text-sm font-semibold uppercase tracking-[0.16em] text-primary-green">
				How we work
			</p>
			<h2 class="mt-4 text-3xl font-semibold tracking-tight text-primary-dark md:text-4xl">
				Our Approach
			</h2>
			<p class="mt-4 text-lg leading-8 text-text">
				We take ideas from concept to launch through a clear, collaborative process designed to
				move your business forward.
			</p>
		</div>

		<ol class="process-list mt-14 grid gap-8 lg:grid-cols-4">
			{
				steps.map((step, index) => (
					<li class="process-step" style={`transition-delay: ${index * 120}ms`}>
						<div class="process-card border border-border bg-white p-6 transition-all duration-300 hover:-translate-y-1 hover:border-[#3A6931] md:p-7">
							<svg
								class="mb-5 size-6 text-[#3A6931]"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								{step.icon === "discover" && (
									<>
										<circle cx="10.8" cy="10.8" r="6.3" />
										<path d="m15.5 15.5 4 4" />
									</>
								)}
								{step.icon === "design" && (
									<>
										<path d="m14.8 5.2 4 4M4 20l4.3-.9L19 7.4a2.1 2.1 0 0 0-3-3L5.3 15.1 4 20Z" />
										<path d="m5.3 15.1 3.4 3.4" />
									</>
								)}
								{step.icon === "develop" && (
									<path d="m8.5 6-6 6 6 6M15.5 6l6 6-6 6M14 4l-4 16" />
								)}
								{step.icon === "deliver" && (
									<>
										<circle cx="12" cy="12" r="9" />
										<path d="m8 12.5 2.5 2.5 5.5-6" />
									</>
								)}
							</svg>
							<p class="text-sm font-semibold tracking-[0.14em] text-primary-green/70">
								{step.number}
							</p>
							<h3 class="mt-2 text-xl font-semibold tracking-tight text-primary-dark">
								{step.title}
							</h3>
							<p class="mt-3 leading-7 text-text">{step.description}</p>
						</div>
						{index < steps.length - 1 && (
							<span class="process-arrow" aria-hidden="true">
								<svg
									class="size-4"
									viewBox="0 0 16 16"
									fill="none"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<path d="m6 3 5 5-5 5" />
								</svg>
							</span>
						)}
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.process-list {
		position: relative;
	}

	.process-list::before {
		position: absolute;
		inset-block: 1.5rem;
		inset-inline-start: 1.5rem;
		width: 1px;
		background: var(--color-border);
		content: "";
	}

	.process-step {
		position: relative;
		z-index: 1;
		min-width: 0;
	}

	.process-card {
		position: relative;
		z-index: 1;
		height: 100%;
	}

	.process-arrow {
		display: none;
	}

	@media (min-width: 64rem) {
		.process-list::before {
			inset: 2.625rem 12.5% auto;
			width: auto;
			height: 1px;
		}

		.process-arrow {
			position: absolute;
			top: 2.125rem;
			right: -1.5rem;
			z-index: 2;
			display: grid;
			width: 1rem;
			height: 1rem;
			place-items: center;
			color: var(--color-primary-green);
		}
	}

	.animate-on-scroll {
		opacity: 0;
		transform: translateY(20px);
		transition: all 0.6s ease-out;
	}

	.animate-on-scroll.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	@media (prefers-reduced-motion: reduce) {
		.animate-on-scroll {
			opacity: 1;
			transform: none;
			transition: none;
		}
	}
</style>

<script is:inline>
	(() => {
		const processSteps = document.querySelectorAll(".process-step");
		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

		processSteps.forEach((step) => step.classList.add("animate-on-scroll"));

		const revealStep = (step) => {
			step.classList.add("is-visible");
			observer?.unobserve(step);
		};

		const observer =
			"IntersectionObserver" in window
				? new IntersectionObserver(
						(entries) => {
							entries.forEach((entry) => {
								if (entry.isIntersecting) revealStep(entry.target);
							});
						},
						{ threshold: 0 },
					)
				: undefined;

		if (observer) processSteps.forEach((step) => observer.observe(step));

		const revealVisibleSteps = () => {
			processSteps.forEach((step) => {
				const bounds = step.getBoundingClientRect();
				if (bounds.top < window.innerHeight && bounds.bottom > 0) revealStep(step);
			});
		};

		revealVisibleSteps();
		window.addEventListener("scroll", revealVisibleSteps, { passive: true });
		window.addEventListener("resize", revealVisibleSteps);
	})();
</script>
