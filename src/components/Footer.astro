		<div class="space-y-2">
			<a href="/" class="text-lg font-bold tracking-tight text-primary-dark dark:text-dark-text">
				Waliya Enterprizes
			</a>
			<p class="text-sm text-text">© {year} Waliya Enterprizes. All rights reserved.</p>
		</div>

		<nav aria-label="Footer navigation" class="flex flex-wrap gap-x-6 gap-y-3">
			<a href="/" class="text-sm text-text transition-colors hover:text-primary-green dark:hover:text-dark-green">Home</a>
			<a href="/services" class="text-sm text-text transition-colors hover:text-primary-green dark:hover:text-dark-green">
				Services
			</a>
			<a href="/about" class="text-sm text-text transition-colors hover:text-primary-green dark:hover:text-dark-green">About</a>
			<a
				href="/client-stories"
				class="text-sm text-text transition-colors hover:text-primary-green dark:hover:text-dark-green"
