---
const isArabic = Astro.url.pathname.startsWith("/ar");
const message = isArabic
	? "مرحباً واليا، أود مناقشة مشروع."
	: "Hi Waliya, I would like to discuss a project.";
const href = `https://wa.me/917032288966?text=${encodeURIComponent(message)}`;
---

<a
	href={href}
	target="_blank"
	rel="noopener noreferrer"
	class:list={[
		"fixed bottom-6 z-50 inline-flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white opacity-0 shadow-md transition-all duration-300 hover:scale-110 hover:shadow-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#25D366]",
		isArabic ? "left-6" : "right-6",
	]}
	data-whatsapp-button
	aria-label={isArabic ? "تواصل معنا عبر واتساب" : "Chat with us on WhatsApp"}
	aria-hidden="true"
	inert
>
	<span
		class="absolute inset-0 z-0 rounded-full bg-[#25D366]/60 motion-safe:animate-ping"
		aria-hidden="true"
	></span>
	<svg
		class="relative z-10 size-7"
		viewBox="0 0 32 32"
		fill="none"
		aria-hidden="true"
	>
		<path
			d="M16 3.5a12 12 0 0 0-10.3 18.1L4 28l6.6-1.7A12 12 0 1 0 16 3.5Z"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
		/>
		<path
			d="M12.1 10.3c-.3-.7-.7-.7-1-.7h-.8c-.3 0-.8.1-1.2.6-.4.5-1.5 1.5-1.5 3.7s1.5 4.3 1.7 4.6c.2.3 2.9 4.6 7.1 6.2 3.5 1.4 4.2 1.1 5 .9.8-.1 2.5-1 2.8-2 .4-1 .4-1.8.3-2-.1-.2-.4-.3-.9-.6-.5-.2-2.5-1.2-2.9-1.3-.4-.2-.7-.2-1 .2-.3.5-1.1 1.3-1.4 1.6-.3.3-.5.4-1 .1-.5-.2-1.9-.7-3.6-2.2-1.3-1.1-2.2-2.5-2.5-3-.3-.5 0-.7.2-.9l.7-.8c.2-.3.3-.5.5-.8.1-.3 0-.6-.1-.8l-1.3-2.8Z"
			fill="currentColor"
			transform="translate(2.5 0) scale(.86)"
		/>
	</svg>
</a>

<script>
	let footerObserver: IntersectionObserver | undefined;

	const initializeWhatsAppButton = () => {
		const button = document.querySelector<HTMLAnchorElement>("[data-whatsapp-button]");
		const footer = document.querySelector("footer");
		if (!button || !footer) return;

		footerObserver?.disconnect();

		footerObserver = new IntersectionObserver(([entry]) => {
			const isVisible = !entry.isIntersecting;
			button.classList.toggle("opacity-0", !isVisible);
			button.classList.toggle("pointer-events-none", !isVisible);
			button.setAttribute("aria-hidden", String(!isVisible));
			button.inert = !isVisible;
		});
		footerObserver.observe(footer);
	};

	document.addEventListener("astro:page-load", initializeWhatsAppButton);
	initializeWhatsAppButton();
</script>
