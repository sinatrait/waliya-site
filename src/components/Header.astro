---
const isArabic = Astro.url.pathname.startsWith("/ar");

const links = [
	{ label: isArabic ? "الرئيسية" : "Home", href: "/" },
	{ label: isArabic ? "خدماتنا" : "Services", href: "/services" },
	{ label: isArabic ? "من نحن" : "About", href: "/about" },
	{ label: isArabic ? "قصص النجاح" : "Client Stories", href: "/client-stories" },
	{ label: isArabic ? "اتصل بنا" : "Contact", href: "/contact", isContact: true },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const englishPath = isArabic ? currentPath.replace(/^\/ar(?=\/|$)/, "") || "/" : currentPath;
const localizedHref = (href: string) =>
	isArabic ? (href === "/" ? "/ar/" : `/ar${href}`) : href;
const supportedLanguagePaths = new Set(["/", "/services", "/about", "/contact", "/client-stories"]);
const languageHref = supportedLanguagePaths.has(englishPath)
	? isArabic
		? englishPath
		: englishPath === "/"
			? "/ar/"
			: `/ar${englishPath}`
	: isArabic
		? "/"
		: "/ar/";
const isCurrentPage = (href: string) => localizedHref(href).replace(/\/$/, "") === currentPath;
---

<header class="sticky top-0 z-50 px-4 pt-4 max-md:fixed max-md:left-0 max-md:z-50 max-md:w-full max-md:bg-transparent">
	<div class="relative mx-auto max-w-7xl">
		<div class="flex items-center justify-between gap-3 rounded-full border border-white/40 bg-white/70 px-4 py-2 shadow-sm backdrop-blur-md dark:border-gray-700/50 dark:bg-gray-900/70 dark:backdrop-blur-md lg:gap-5 lg:py-2 lg:pl-6 lg:pr-2">
			<a
				href={isArabic ? "/ar/" : "/"}
				class="inline-flex shrink-0 items-center"
				aria-label={isArabic ? "الصفحة الرئيسية لواليا" : "Waliya home"}
			>
				<img src="/waliya-logo.svg" alt="Waliya Logo" class="h-6 w-auto md:h-7 dark:brightness-0 dark:invert" />
			</a>

			<nav aria-label={isArabic ? "التنقل الرئيسي" : "Main navigation"} class="hidden items-center gap-6 lg:flex">
				{
					links.map((link) => (
						<a
							href={link.isContact ? `${localizedHref(link.href)}?ref=nav` : localizedHref(link.href)}
							data-is-nav={link.isContact ? "true" : undefined}
							class:list={[
								"relative whitespace-nowrap py-2 text-sm font-medium transition-colors after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5 after:origin-left after:scale-x-0 after:bg-[#3A6931] after:transition-transform after:duration-300 hover:text-[#3A6931] hover:after:scale-x-100 dark:after:bg-dark-green dark:hover:text-dark-green",
								isCurrentPage(link.href)
									? "font-semibold text-[#3A6931] after:scale-x-100 dark:text-dark-green"
									: "text-text",
							]}
							aria-current={isCurrentPage(link.href) ? "page" : undefined}
						>
							{link.label}
						</a>
					))
				}
			</nav>

			<div class="flex shrink-0 items-center gap-2">
				<button
					type="button"
					class="inline-flex size-10 items-center justify-center rounded-full text-text transition-colors hover:bg-surface dark:hover:bg-gray-800"
					data-theme-toggle
					aria-label="Switch to dark mode"
					aria-pressed="false"
				>
					<svg
						class="size-5"
						data-theme-icon="moon"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M20.2 15.2A8.5 8.5 0 0 1 8.8 3.8 8.5 8.5 0 1 0 20.2 15.2Z"></path>
					</svg>
					<svg
						class="hidden size-5"
						data-theme-icon="sun"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<circle cx="12" cy="12" r="4"></circle>
						<path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path>
					</svg>
				</button>
				<a
					href={languageHref}
					lang={isArabic ? "en" : "ar"}
					class="inline-flex h-10 min-w-10 items-center justify-center rounded-full px-3 text-sm font-semibold text-text transition-colors hover:bg-surface dark:hover:bg-gray-800"
					aria-label={isArabic ? "Switch to English" : "التبديل إلى العربية"}
				>
					{isArabic ? "EN" : "عربي"}
				</a>

				<a
					href={localizedHref("/contact")}
					class="hidden rounded-full bg-[#3A6931] px-6 py-2.5 text-sm font-medium text-white transition-colors hover:bg-[#2A4D24] lg:inline-flex"
				>
					{isArabic ? "تواصل معنا" : "Get in Touch"}
				</a>

				<button
					id="mobile-menu-button"
					type="button"
					class="inline-flex size-10 items-center justify-center rounded-full text-text transition-colors hover:bg-surface lg:hidden dark:hover:bg-gray-800"
					aria-controls="mobile-menu"
					aria-expanded="false"
					aria-label={isArabic ? "فتح قائمة التنقل" : "Open navigation menu"}
				>
					<svg
						id="hamburger-icon"
						class="size-6"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M4 7h16M4 12h16M4 17h16"></path>
					</svg>
					<svg
						id="close-icon"
						class="hidden size-6"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="m6 6 12 12M18 6 6 18"></path>
					</svg>
				</button>
			</div>
		</div>

		<nav
			id="mobile-menu"
			aria-label={isArabic ? "التنقل عبر الهاتف" : "Mobile navigation"}
			class="absolute left-0 right-0 top-full mt-2 hidden rounded-3xl border border-[#E5E3DC] bg-white/95 px-5 py-3 shadow-sm backdrop-blur-md dark:border-gray-800 dark:bg-gray-900/95 lg:hidden"
		>
			<div class="flex flex-col">
				{
					links.map((link) => (
						<a
							href={link.isContact ? `${localizedHref(link.href)}?ref=nav` : localizedHref(link.href)}
							data-is-nav={link.isContact ? "true" : undefined}
							class:list={[
								"border-b border-border py-3 text-sm last:border-0 hover:text-primary-green dark:hover:text-dark-green",
								isCurrentPage(link.href)
									? "bg-surface font-bold text-primary-green dark:bg-dark-page dark:text-dark-green"
									: "font-medium text-text",
							]}
							aria-current={isCurrentPage(link.href) ? "page" : undefined}
						>
							{link.label}
						</a>
					))
				}
			</div>
		</nav>
	</div>
</header>

<script is:inline>
	(() => {
		const syncThemeButtons = () => {
			const isDark = document.documentElement.classList.contains("dark");
			const isArabic = document.documentElement.lang === "ar";
			document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
				button.setAttribute("aria-pressed", String(isDark));
				button.setAttribute(
					"aria-label",
					isArabic
						? `التبديل إلى الوضع ${isDark ? "الفاتح" : "الداكن"}`
						: `Switch to ${isDark ? "light" : "dark"} mode`,
				);
			});
			document.querySelectorAll('[data-theme-icon="moon"]').forEach((icon) => {
				icon.classList.toggle("hidden", isDark);
			});
			document.querySelectorAll('[data-theme-icon="sun"]').forEach((icon) => {
				icon.classList.toggle("hidden", !isDark);
			});
		};

		const setMobileMenuOpen = (isOpen) => {
			const menuButton = document.getElementById("mobile-menu-button");
			const mobileMenu = document.getElementById("mobile-menu");
			const hamburgerIcon = document.getElementById("hamburger-icon");
			const closeIcon = document.getElementById("close-icon");
			if (!menuButton || !mobileMenu || !hamburgerIcon || !closeIcon) return;

			mobileMenu.classList.toggle("hidden", !isOpen);
			hamburgerIcon.classList.toggle("hidden", isOpen);
			closeIcon.classList.toggle("hidden", !isOpen);
			menuButton.setAttribute("aria-expanded", String(isOpen));
			const isArabic = document.documentElement.lang === "ar";
			menuButton.setAttribute(
				"aria-label",
				isArabic
					? isOpen
						? "إغلاق قائمة التنقل"
						: "فتح قائمة التنقل"
					: isOpen
						? "Close navigation menu"
						: "Open navigation menu",
			);
		};

		if (document.documentElement.dataset.headerInteractionsBound !== "true") {
			document.documentElement.dataset.headerInteractionsBound = "true";
			document.addEventListener("click", (event) => {
				if (!(event.target instanceof Element)) return;

				if (event.target.closest("[data-theme-toggle]")) {
					const nextIsDark = !document.documentElement.classList.contains("dark");
					document.documentElement.classList.toggle("dark", nextIsDark);
					try {
						localStorage.setItem("theme", nextIsDark ? "dark" : "light");
					} catch (error) {
						console.error("Unable to save the theme preference.", error);
					}
					syncThemeButtons();
				}

				if (event.target.closest("#mobile-menu-button")) {
					const isOpen =
						document.getElementById("mobile-menu-button")?.getAttribute("aria-expanded") ===
						"true";
					setMobileMenuOpen(!isOpen);
				}

				if (event.target.closest("#mobile-menu a")) setMobileMenuOpen(false);
			});

			document.addEventListener("keydown", (event) => {
				if (event.key === "Escape") setMobileMenuOpen(false);
			});
		}

		document.addEventListener("astro:page-load", () => {
			syncThemeButtons();
			setMobileMenuOpen(false);
		});
		syncThemeButtons();
		setMobileMenuOpen(false);
	})();
</script>
