---
const links = [
	{ label: "Home", href: "/" },
	{ label: "Services", href: "/services" },
	{ label: "About", href: "/about" },
	{ label: "Client Stories", href: "/client-stories" },
	{ label: "Contact", href: "/contact" },
];
---

<header class="sticky top-0 z-50 border-b border-border bg-white">
	<div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-5">
		<a
			href="/"
			class="shrink-0 text-lg font-bold tracking-tight text-primary-dark"
			aria-label="Waliya Enterprizes home"
		>
			Waliya Enterprizes
		</a>

		<nav aria-label="Main navigation" class="hidden items-center gap-8 md:flex">
			{
				links.map((link) => (
					<a
						href={link.href}
						class="text-sm font-medium text-text transition-colors hover:text-primary-green"
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="flex shrink-0 items-center gap-5">
			<span class="text-sm font-medium text-text md:hidden">Menu</span>
			<a
				href="/contact"
				class="inline-flex items-center justify-center bg-primary-green px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-primary-dark"
			>
				Get in Touch
			</a>
		</div>
	</div>
</header>
