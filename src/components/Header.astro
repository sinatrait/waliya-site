---
const links = [
	{ label: "Home", href: "/" },
	{ label: "Services", href: "/services" },
	{ label: "About", href: "/about" },
	{ label: "Client Stories", href: "/client-stories" },
	{ label: "Contact", href: "/contact" },
];
---

<header class="sticky top-0 z-50 border-b border-border bg-white">
	<div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-5">
		<a
			href="/"
			class="shrink-0 text-lg font-bold tracking-tight text-primary-dark"
			aria-label="Waliya Enterprizes home"
		>
			Waliya Enterprizes
		</a>

		<nav aria-label="Main navigation" class="hidden items-center gap-8 md:flex">
			{
				links.map((link) => (
					<a
						href={link.href}
						class="text-sm font-medium text-text transition-colors hover:text-primary-green"
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="flex shrink-0 items-center gap-5">
			<button
				id="mobile-menu-button"
				type="button"
				class="inline-flex items-center gap-2 text-sm font-medium text-text md:hidden"
				aria-controls="mobile-menu"
				aria-expanded="false"
			>
				<span>Menu</span>
				<svg
					class="size-5"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<path d="M4 7h16M4 12h16M4 17h16"></path>
				</svg>
			</button>
			<a
				href="/contact"
				class="hidden items-center justify-center bg-primary-green px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-primary-dark md:inline-flex"
			>
				Get in Touch
			</a>
		</div>
	</div>
	<nav
		id="mobile-menu"
		aria-label="Mobile navigation"
		class="hidden border-t border-border bg-white md:hidden"
	>
		<div class="mx-auto flex max-w-7xl flex-col px-6 py-3">
			{
				links.map((link) => (
					<a
						href={link.href}
						class="border-b border-border py-3 text-sm font-medium text-text last:border-0 hover:text-primary-green"
					>
						{link.label}
					</a>
				))
			}
		</div>
	</nav>
</header>

<script is:inline>
	(() => {
		const initializeMobileMenu = () => {
			const menuButton = document.getElementById("mobile-menu-button");
			const mobileMenu = document.getElementById("mobile-menu");

			if (!menuButton || !mobileMenu || menuButton.dataset.initialized === "true") return;
			menuButton.dataset.initialized = "true";

			menuButton.addEventListener("click", () => {
				const isExpanded = menuButton.getAttribute("aria-expanded") === "true";
				mobileMenu.classList.toggle("hidden");
				menuButton.setAttribute("aria-expanded", String(!isExpanded));
			});
		};

		document.addEventListener("astro:page-load", initializeMobileMenu);
		initializeMobileMenu();
	})();
</script>
