---
const slides = [
	{
		id: "digital-solutions",
		image: "/images/hero.jpg",
		headline: "Digital Solutions & Business Services That Move You Forward",
		subheadline:
			"We help startups, small businesses, and individuals establish their digital presence and access practical business support.",
	},
	{
		id: "websites-that-drive-growth",
		image: "/images/Unsplash/img2.jpg",
		headline: "Websites That Drive Growth.",
		subheadline:
			"We design and develop high-performance digital storefronts that convert visitors into loyal customers.",
	},
	{
		id: "brands-that-stand-out",
		image: "/images/Unsplash/img3.jpg",
		headline: "Brands That Stand Out.",
		subheadline:
			"From logos to full visual identities, we craft memorable designs that make your business instantly recognizable.",
	},
	{
		id: "strategies-that-deliver",
		image: "/images/Unsplash/img4.jpg",
		headline: "Strategies That Deliver.",
		subheadline:
			"Data-driven digital marketing campaigns that increase your visibility and bring in qualified leads.",
	},
];
---

<section
	id="hero-carousel"
	class="hero-grid relative isolate min-h-[100svh] bg-[#F7F6F2] dark:bg-dark-page md:min-h-0"
	role="region"
	aria-roledescription="carousel"
	aria-label="Featured services"
>
	<div class="relative mx-auto grid min-h-[100svh] w-full max-w-7xl grid-cols-1 items-center md:min-h-[80vh] md:grid-cols-2 md:gap-16 md:px-6 md:py-24">
		<div class="fade-up relative z-10 flex min-h-[100svh] flex-col justify-center px-6 py-20 md:ml-4 md:min-h-[520px] md:px-0 md:py-0" style="animation-delay: 100ms">
			{slides.map((slide, index) => (
				<div
					id={`hero-copy-${slide.id}`}
					class:list={[
						"hero-copy-slide absolute inset-0 flex flex-col justify-center px-6 pt-36 pb-40 transition-opacity duration-1000 ease-in-out md:px-0 md:py-0",
						index === 0 ? "opacity-100" : "opacity-0",
					]}
					aria-hidden={index === 0 ? "false" : "true"}
					data-active={index === 0 ? "true" : "false"}
					inert={index !== 0}
				>
					<p class="mb-5 text-sm font-semibold uppercase tracking-[0.16em] text-white/85 md:text-primary-green dark:md:text-dark-green">
						Waliya
					</p>
					<h1 class="max-w-3xl text-4xl font-extrabold leading-[1.05] tracking-tight text-white md:text-7xl md:text-primary-dark dark:md:text-dark-text">
						{slide.headline}
					</h1>
					<p class="mt-6 max-w-xl text-base leading-7 text-white/90 md:mt-7 md:text-lg md:leading-8 md:text-text">
						{slide.subheadline}
					</p>
					<div class="mt-9 grid w-full grid-cols-2 gap-3 md:flex md:flex-row md:w-auto md:gap-4">
						<a
							href="/contact"
							class="inline-flex w-full items-center justify-center bg-[#3A6931] px-2 py-3 text-sm font-semibold text-white transition-colors hover:bg-primary-dark md:w-auto md:px-6 md:py-3.5"
						>
							Start a Conversation
						</a>
						<a
							href="/services"
							class="inline-flex w-full items-center justify-center border border-white px-2 py-3 text-sm font-semibold text-white transition-colors hover:bg-white hover:text-primary-dark md:w-auto md:px-6 md:py-3.5 md:border-primary-green md:text-primary-green md:hover:bg-primary-green md:hover:text-white dark:md:border-dark-green dark:md:text-dark-green dark:md:hover:bg-dark-green dark:md:hover:text-dark-page"
						>
							Explore Services
						</a>
					</div>
				</div>
			))}
		</div>

		<div class="hero-image-background fade-up absolute inset-0 z-0 h-full w-full md:relative md:inset-auto md:z-auto md:ml-4 md:h-auto md:w-auto" style="animation-delay: 500ms">
			<div class="hero-image-frame relative h-full w-full overflow-hidden bg-[#E5E3DC] dark:bg-dark-border md:aspect-[5/6] md:h-auto md:w-auto">
				{slides.map((slide, index) => (
					<div
						class:list={[
							"hero-image-slide absolute inset-0 transition-opacity duration-1000 ease-in-out",
							index === 0 ? "opacity-100" : "opacity-0",
						]}
						aria-hidden="true"
						data-active={index === 0 ? "true" : "false"}
					>
						<img
							class="hero-image h-full w-full object-cover"
							src={slide.image}
							alt=""
							fetchpriority={index === 0 ? "high" : "auto"}
							loading={index === 0 ? "eager" : "lazy"}
						/>
					</div>
				))}
				<div
					class="absolute inset-0 z-0 bg-gradient-to-t from-black/80 via-black/50 to-black/20 md:hidden"
					aria-hidden="true"
				></div>
				<button
					type="button"
					class="hero-rotation-toggle absolute bottom-6 right-6 z-10 border border-[#E5E3DC] bg-white/95 px-3 py-2 text-xs font-semibold text-primary-dark transition-[opacity,color,background-color] duration-200 hover:bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-green dark:border-dark-border dark:bg-dark-surface/95 dark:text-dark-text dark:hover:bg-dark-surface"
					aria-controls="hero-carousel"
					aria-pressed="false"
				>
					Pause
				</button>
				<div class="absolute bottom-8 left-6 z-20 flex max-w-[calc(100%-3rem)] items-center gap-2 border border-[#E5E3DC] bg-white/95 px-3 py-3 shadow-lg backdrop-blur-sm dark:border-dark-border dark:bg-dark-surface/95 md:bottom-6 md:left-6 sm:gap-3 sm:px-5">
					<span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-[#F7F6F2] text-primary-green dark:bg-dark-page dark:text-dark-green sm:size-9">
						<svg
							class="size-5"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.8"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="m5 12 4 4L19 6"></path>
						</svg>
					</span>
					<span class="text-xs font-semibold text-primary-dark dark:text-dark-text sm:text-sm">
						Trusted by 20+ businesses
					</span>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	let cleanupCarousel: (() => void) | undefined;

	function initializeHeroCarousel() {
		cleanupCarousel?.();

		const hero = document.querySelector(".hero-grid");
		if (!hero) return;

		const copySlides = Array.from(hero.querySelectorAll<HTMLElement>(".hero-copy-slide"));
		const imageSlides = Array.from(hero.querySelectorAll<HTMLElement>(".hero-image-slide"));
		const toggle = hero.querySelector<HTMLButtonElement>(".hero-rotation-toggle");

		if (copySlides.length !== imageSlides.length || copySlides.length < 2 || !toggle) {
			throw new Error("Hero carousel requires matching text and image slides, and a rotation toggle.");
		}

		let activeIndex = 0;
		let intervalId: number | undefined;
		const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
		let manuallyPaused = prefersReducedMotion.matches;

		const showSlide = (nextIndex: number) => {
			copySlides[activeIndex].classList.replace("opacity-100", "opacity-0");
			copySlides[activeIndex].setAttribute("aria-hidden", "true");
			copySlides[activeIndex].dataset.active = "false";
			copySlides[activeIndex].inert = true;
			imageSlides[activeIndex].classList.replace("opacity-100", "opacity-0");
			imageSlides[activeIndex].dataset.active = "false";

			activeIndex = nextIndex;
			copySlides[activeIndex].classList.replace("opacity-0", "opacity-100");
			copySlides[activeIndex].setAttribute("aria-hidden", "false");
			copySlides[activeIndex].dataset.active = "true";
			copySlides[activeIndex].inert = false;
			imageSlides[activeIndex].classList.replace("opacity-0", "opacity-100");
			imageSlides[activeIndex].dataset.active = "true";
		};

		const stopRotation = () => {
			if (intervalId !== undefined) {
				window.clearInterval(intervalId);
				intervalId = undefined;
			}
		};

		const startRotation = () => {
			stopRotation();
			intervalId = window.setInterval(() => {
				showSlide((activeIndex + 1) % copySlides.length);
			}, 10000);
		};

		const syncRotation = () => {
			if (manuallyPaused) {
				stopRotation();
			} else if (intervalId === undefined) {
				startRotation();
			}

			toggle.textContent = manuallyPaused ? "Play" : "Pause";
			toggle.setAttribute("aria-pressed", String(manuallyPaused));
		};

		const onToggle = () => {
			manuallyPaused = !manuallyPaused;
			syncRotation();
		};

		toggle.addEventListener("click", onToggle);
		syncRotation();

		cleanupCarousel = () => {
			stopRotation();
			toggle.removeEventListener("click", onToggle);
			cleanupCarousel = undefined;
		};
	}

	document.addEventListener("astro:page-load", initializeHeroCarousel);
	document.addEventListener("astro:before-swap", () => cleanupCarousel?.());
	initializeHeroCarousel();
</script>

<style>
	.hero-grid {
		background-image:
			linear-gradient(rgba(42, 77, 36, 0.045) 1px, transparent 1px),
			linear-gradient(90deg, rgba(42, 77, 36, 0.045) 1px, transparent 1px);
		background-size: 44px 44px;
	}

	:global(.dark) .hero-grid {
		background-image:
			linear-gradient(rgba(249, 250, 251, 0.035) 1px, transparent 1px),
			linear-gradient(90deg, rgba(249, 250, 251, 0.035) 1px, transparent 1px);
	}

	.hero-image {
		animation: hero-ken-burns 20s ease-out forwards;
	}

	.hero-copy-slide[data-active="false"],
	.hero-image-slide[data-active="false"] {
		opacity: 0;
		pointer-events: none;
	}

	.hero-rotation-toggle {
		bottom: 1.5rem;
		right: 1.5rem;
	}

	@media (hover: hover) and (pointer: fine) {
		.hero-rotation-toggle:not(:focus-visible) {
			opacity: 0;
			pointer-events: none;
		}

		.hero-image-frame:hover .hero-rotation-toggle,
		.hero-image-frame:focus-within .hero-rotation-toggle {
			opacity: 1;
			pointer-events: auto;
		}
	}

	.fade-up {
		opacity: 0;
		transform: translateY(20px);
		animation: hero-fade-up 800ms ease-out both;
	}

	@media (max-width: 767px) and (max-height: 700px) {
		.hero-copy-slide {
			padding-top: 6rem;
			padding-bottom: 7rem;
		}

		.hero-copy-slide > p:first-child {
			margin-bottom: 0.75rem;
		}

		.hero-copy-slide h1 {
			font-size: clamp(1.75rem, 8vw, 2rem);
		}

		.hero-copy-slide > p:nth-of-type(2) {
			margin-top: 1rem;
			font-size: 0.9375rem;
			line-height: 1.35rem;
		}

		.hero-copy-slide .mt-9 {
			margin-top: 1rem;
		}

		.hero-copy-slide a {
			padding-top: 0.75rem;
			padding-bottom: 0.75rem;
			font-size: 0.8125rem;
		}
	}

	@media (max-width: 767px) {
		.hero-image-background.fade-up {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}

	@keyframes hero-ken-burns {
		from {
			transform: scale(1);
		}

		to {
			transform: scale(1.05);
		}
	}

	@keyframes hero-fade-up {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-image,
		.fade-up {
			animation: none;
		}

		.hero-copy-slide,
		.hero-image-slide {
			transition: none;
		}

		.fade-up {
			opacity: 1;
			transform: none;
		}
	}
</style>
