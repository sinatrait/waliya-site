---
import ServiceCard from "./ServiceCard.astro";

const services = [
	{
		title: "Website Design & Development",
		icon: "website",
		description:
			"Custom-built, responsive websites that act as the digital storefront for your business.",
	},
	{
		title: "UI/UX Design",
		icon: "uiux",
		description:
			"Intuitive user journeys and polished interfaces that make every digital interaction feel effortless.",
	},
	{
		title: "Graphic Design & Branding",
		icon: "branding",
		description:
			"Logo creation and visual identities that ensure your brand looks professional everywhere.",
	},
	{
		title: "Digital Marketing",
		icon: "marketing",
		description:
			"Data-driven strategies to increase your visibility and drive qualified traffic to your site.",
	},
];
---

<section class="bg-[linear-gradient(180deg,#F7F6F2_0%,#FFFFFF_100%)] py-20 dark:bg-none dark:bg-dark-page md:py-24">
	<div class="mx-auto max-w-7xl px-6">
		<div class="max-w-2xl">
			<p class="text-sm font-semibold uppercase tracking-[0.16em] text-primary-green dark:text-dark-green">
				What we do
			</p>
			<h2 class="mt-4 text-3xl font-semibold tracking-tight text-primary-dark dark:text-dark-text md:text-4xl">
				Our Services
			</h2>
			<p class="mt-4 text-lg leading-8 text-text">
				Practical digital solutions to help your business build, maintain, and grow its online presence.
			</p>
		</div>

		<div class="mx-auto mt-12 grid max-w-6xl grid-cols-1 gap-5 md:grid-cols-3">
			{services.map((service, index) => (
				<ServiceCard
					{...service}
					showBullets={false}
					layout={index === 0 || index === 3 ? "wide" : "standard"}
					variant={index === 0 ? "featured" : index === 3 ? "surface" : "standard"}
				/>
			))}
		</div>
		<div class="mx-auto mt-8 max-w-6xl">
			<a
				href="/services"
				class="inline-flex items-center gap-2 text-sm font-semibold text-primary-green transition-colors hover:text-primary-dark dark:text-dark-green dark:hover:text-dark-text"
			>
				Learn more about our services <span aria-hidden="true">→</span>
			</a>
		</div>
	</div>
</section>
